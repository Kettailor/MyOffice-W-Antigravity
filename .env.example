# ============================================================================
# Work Office 3D — Cấu hình Môi trường Mẫu (.env.example)
# Sao chép file này thành `.env` (`cp .env.example .env`) để tùy chỉnh riêng
# ============================================================================

# Cổng chạy Web Server (Mặc định: 4310)
OFFICE_PORT=4310

# Tên mạng Wi-Fi (SSID) được phép chia sẻ trong mạng nội bộ.
# - Đặt `*` (mặc định) để cho phép mạng Wi-Fi hiện tại của máy chủ (vẫn tự động chặn mạng dây Ethernet LAN).
# - Hoặc điền tên Wi-Fi cụ thể của bạn để chỉ mở khi kết nối đúng Wi-Fi đó (ví dụ: OFFICE_WIFI_SSID=MyHomeWiFi).
OFFICE_WIFI_SSID=*

# (Tùy chọn) Ghi đè địa chỉ IP Wi-Fi hoặc Tailscale thủ công nếu cần:
# OFFICE_WIFI_IP=
# OFFICE_TS_IP=

# (Tùy chọn) Ổ đĩa chứa các dự án khi chạy qua Docker Compose (Mặc định: E:/):
# OFFICE_HOST_DRIVE=E:/

# (Tùy chọn) Giới hạn số tác vụ AI chạy đồng thời:
# OFFICE_MAX_CONCURRENT_TASKS=12
# OFFICE_TASKS_PER_HOUR=100
